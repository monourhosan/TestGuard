# TestGuard Environment Configuration Template
# WARNING: Change all secrets and keys before deploying to non-development environments!

# Application Settings
PROJECT_NAME="TestGuard"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT
# IMPORTANT: In production, generate a cryptographically strong secret with `openssl rand -hex 32`
SECRET_KEY="dev-insecure-secret-key-change-me-in-production-environments-32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Default local development uses PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=testguard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testguard

# Dedicated Test Database (Used by test suite when PostgreSQL is active)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testguard_test

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
